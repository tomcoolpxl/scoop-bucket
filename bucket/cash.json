{
    "version": "1.1.3",
    "description": "Cool Again Shell: a Bash-language shell for Windows, with its Unix tools built in",
    "homepage": "https://github.com/tomcoolpxl/cash",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/tomcoolpxl/cash/blob/main/LICENSE"
    },
    "notes": [
        "Windows Terminal lists a \"cash\" profile (restart Terminal if it does not show).",
        "For the file icons of `ls --icons`, a Nerd Font (per-user, no admin), then refresh the profile:",
        "    scoop bucket add nerd-fonts",
        "    scoop install nerd-fonts/CascadiaMono-NF",
        "    cash --terminal-profile",
        "For programs outside cash to run its tools (ls.exe, sort.exe ...), run once:",
        "    cash --link-tools --add-to-path",
        "To upgrade while a cash window is open: scoop config ignore_running_processes true"
    ],
    "suggest": {
        "carapace": "extras/carapace-bin",
        "Nerd Font": "nerd-fonts/CascadiaMono-NF"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tomcoolpxl/cash/releases/download/v1.1.3/cash-v1.1.3-x86_64-pc-windows-msvc.zip",
            "hash": "3e9a2e8978e35c969730c34693204a4a18e1358f1050ea2c65297bcf396cd416"
        }
    },
    "bin": "cash.exe",
    "persist": "bin",
    "post_install": [
        "$cash = \"$(Split-Path $dir)\\current\\cash.exe\"",
        "& $cash --terminal-profile | Out-Null",
        "if (Test-Path \"$persist_dir\\bin\\.cash-links\") { & $cash --link-tools | Out-Null }"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    if (Test-Path \"$persist_dir\\bin\\.cash-links\") { & \"$dir\\cash.exe\" --unlink-tools | Out-Null }",
        "    & \"$dir\\cash.exe\" --remove-terminal-profile | Out-Null",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tomcoolpxl/cash/releases/download/v$version/cash-v$version-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
